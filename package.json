{
  "name": "docs2api-lab",
  "version": "0.1.0",
  "description": "Turn API documentation into local sandboxes. Build before credentials arrive.",
  "type": "module",
  "license": "MIT",
  "bin": { "docs2api": "dist/server/cli.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch src/server/cli.ts --no-open",
    "build": "tsc --noEmit && vite build && tsup",
    "start": "node --env-file-if-exists=.env dist/server/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.1.2",
    "diff": "^8.0.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "open": "^10.2.0",
    "openai": "^6.0.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vite": "^6.1.0",
    "vitest": "^3.2.0"
  }
}
